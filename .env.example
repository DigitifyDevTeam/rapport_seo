# Copy this file to `.env` and fill in the values you need.
# Only the integrations you actually use have to be configured.

# Path to your customized report template (.pptx). Defaults to
# templates/seo_report_template.pptx. Edit that file in PowerPoint; monthly
# runs use it as-is (placeholders only). Use this if OneDrive locks the file.
SEO_REPORT_TEMPLATE_PATH=

# Optional: override GA4 property_id from config/clients.yaml without editing YAML.
# Use the numeric Property ID from GA4 Admin. Per-client form wins over generic:
#   GA4_PROPERTY_ID_DEEPCLEANING=123456789
#   GA4_PROPERTY_ID_ORIGINCBD=123456789
#   GA4_PROPERTY_ID_DIGITIFY=366533803
#   GA4_PROPERTY_ID_CCHABITAT=339322990
GA4_PROPERTY_ID=
GA4_PROPERTY_ID_DEEPCLEANING=
GA4_PROPERTY_ID_ORIGINCBD=
GA4_PROPERTY_ID_DIGITIFY=
GA4_PROPERTY_ID_CCHABITAT=

# Path to a Google service account JSON key with access to GA4 and GSC.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google_service_account.json

# Alternative (OAuth) Google credentials.
# Put your OAuth client JSON in this path and generate a token file with:
#   python scripts/google_oauth_login.py
# Use a **Desktop** OAuth client JSON (top-level key "installed") for the script.
# If GOOGLE_OAUTH_TOKEN_FILE exists, it takes precedence over per-product
# GOOGLE_ANALYTICS_* / GOOGLE_SEARCH_CONSOLE_* / GOOGLE_BUSINESS_PROFILE_* vars.
GOOGLE_OAUTH_CLIENT_SECRET_FILE=./secrets/google_oauth_client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=./secrets/google_oauth_token.json

# Optional: separate OAuth client/token files per Google product.
GOOGLE_OAUTH_CLIENT_SECRET_FILE_GA4=
GOOGLE_OAUTH_TOKEN_FILE_GA4=
GOOGLE_OAUTH_CLIENT_SECRET_FILE_GSC=
GOOGLE_OAUTH_TOKEN_FILE_GSC=
GOOGLE_OAUTH_CLIENT_SECRET_FILE_GMB=
GOOGLE_OAUTH_TOKEN_FILE_GMB=

# Optional: same values as in your OAuth client JSON / token (fill locally).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token

# Optional: per-product OAuth fields (fill locally if not using token JSON files).
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REFRESH_TOKEN=
GOOGLE_ANALYTICS_ACCESS_TOKEN=
GOOGLE_ANALYTICS_TOKEN_TYPE=Bearer
GOOGLE_ANALYTICS_EXPIRES_IN=
# Optional: absolute expiry / issue time so EXPIRES_IN is interpreted correctly.
GOOGLE_ANALYTICS_EXPIRES_AT=
GOOGLE_ANALYTICS_ISSUED_AT=
GOOGLE_ANALYTICS_SCOPE=https://www.googleapis.com/auth/analytics
GOOGLE_ANALYTICS_TOKEN_URI=

GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_TOKEN_TYPE=Bearer
GOOGLE_SEARCH_CONSOLE_EXPIRES_IN=
GOOGLE_SEARCH_CONSOLE_EXPIRES_AT=
GOOGLE_SEARCH_CONSOLE_ISSUED_AT=
GOOGLE_SEARCH_CONSOLE_SCOPE=https://www.googleapis.com/auth/webmasters
GOOGLE_SEARCH_CONSOLE_TOKEN_URI=

GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_REFRESH_TOKEN=
GOOGLE_BUSINESS_PROFILE_ACCESS_TOKEN=
GOOGLE_BUSINESS_PROFILE_TOKEN_TYPE=Bearer
GOOGLE_BUSINESS_PROFILE_EXPIRES_IN=
GOOGLE_BUSINESS_PROFILE_EXPIRES_AT=
GOOGLE_BUSINESS_PROFILE_ISSUED_AT=
GOOGLE_BUSINESS_PROFILE_SCOPE=https://www.googleapis.com/auth/business.manage
GOOGLE_BUSINESS_PROFILE_TOKEN_URI=

# Default agency name shown on the cover slide.
AGENCY_NAME=DIGITIFY

# Microsoft Clarity Data Export API token.
CLARITY_API_TOKEN=
CLARITY_PROJECT_ID_DEEPCLEANING=
CLARITY_PROJECT_ID_ORIGINCBD=
CLARITY_PROJECT_ID_DIGITIFY=
CLARITY_PROJECT_ID_CCHABITAT=

# CC Habitat: separate Google account for GSC + GMB (not the agency token).
# Run: python scripts/clients/cchabitat/google_oauth_login.py
GOOGLE_OAUTH_TOKEN_FILE_CCHABITAT=./secrets/google_oauth_token_cchabitat.json
# Optional: default API URL (override if Microsoft changes the host).
CLARITY_API_URL=https://www.clarity.ms/export-data/api/v1/project-live-insights

# Google Business Profile is accessed through the Google service account
# above plus the Business Profile APIs enabled in the same Google Cloud
# project. No extra token is required.

# --- Monthly VPS schedule (25th → current month report) ---
REPORT_CYCLE_DAY=25
SEO_REPORT_SCHEDULE_DAY=25
SEO_REPORT_SCHEDULE_HOUR=6
SEO_REPORT_SCHEDULE_MINUTE=0
# Comma-separated client ids for scheduled runs (default: all except "example")
# SEO_REPORT_CLIENT_IDS=cchabitat,digitify,deepcleaning,origincbd

# GA4 UI: capture real dashboard cards on every report run (default).
# Set SEO_REPORT_GA4_REUSE_CAPTURES=true to skip re-screenshot when PNGs exist.
# Set SEO_REPORT_GA4_ALLOW_STATIC_FALLBACK=true to use scripts/clients/*/ga4_assets/.
# One-time login: python scripts/ga4_ui_prepare.py  (or reuse GMB profile via ui_session_client)

# Skip browser-based UI capture (Playwright/Puppeteer) for GMB/Clarity.
# Does NOT affect API data — only the dashboard screenshots.
# SEO_REPORT_SKIP_UI_CONNECTORS=gmb,clarity

# Skip entire API connectors (no data at all for these):
# SEO_REPORT_SKIP_CONNECTORS=gmb,clarity

# GMB location IDs — set these to avoid 429 rate limits from account discovery.
# Find yours: python scripts/_discover_all_gmb.py  (or check business.google.com URL)
# Format: locations/1234567890  or just  1234567890
GMB_LOCATION_ID_ORIGINCBD=
GMB_LOCATION_ID_DIGITIFY=
GMB_LOCATION_ID_DEEPCLEANING=
GMB_LOCATION_ID_CCHABITAT=

# PDF export: set to "true" to generate PDF alongside PPTX (default: false)
# SEO_REPORT_EXPORT_PDF=false

# --- Google Drive upload (after each report) ---
# OAuth (same token as GA4/GSC): run `python scripts/google_drive_setup.py`
# once after enabling Drive API. Service account: share folder with its email.
# Folder ID for your Drive folder "rapport_seo" (from the folder URL).
# Upload path: rapport_seo/<project-name>/YYYY-MM/*.pptx
GOOGLE_DRIVE_FOLDER_ID=
# Optional per-client Drive folder name (default: clients.yaml ``name``)
# GOOGLE_DRIVE_PROJECT_NAME_DIGITIFY=Digitify
GOOGLE_DRIVE_UPLOAD_ENABLED=true
GOOGLE_DRIVE_UPLOAD_PPTX=true
GOOGLE_DRIVE_UPLOAD_PDF=true
GOOGLE_DRIVE_UPLOAD_JSON=false
# Optional separate service account JSON (defaults to GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_DRIVE_CREDENTIALS=

# Optional SMTP configuration for monthly delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=reports@example.com
