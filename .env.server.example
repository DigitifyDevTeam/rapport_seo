# Copy these lines into your `.env` on the OVH VPS (or: cp .env.server.example .env.server
# and keep secrets in `.env` only). Do not commit `.env` — it is gitignored.
#
# 94.23.210.145 = public IP of the OVH server (digitify.fr), NOT your office IP.
# SSH_ALLOWED_IP_NEW = your current public IP from your PC (https://api.ipify.org).

# OVH / Digitify server
OVH_SERVER_IP=94.23.210.145
OVH_SERVER_HOST=digitify.fr
SSH_PORT=22
VNC_PORT=7900

# SSH allowlist (office / building egress)
SSH_ALLOWED_IP_OLD=197.5.129.6
# Fill after check from your PC: curl -s https://api.ipify.org
SSH_ALLOWED_IP_NEW=

# Optional: SSH user for tests from your PC (default: your login name)
# OVH_SSH_USER=new
